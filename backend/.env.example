# GoodCheck — Backend Environment Variables
# Copy this file to .env and fill in real values before running
#
#   cp .env.example .env
#

# ─── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development           # development | production
FLASK_DEBUG=True                # ตั้งเป็น False ใน production

# ─── Security (เปลี่ยนก่อน deploy production!) ──────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES=2592000   # วินาที (2592000 = 30 วัน)

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///goodcheck.db
# สำหรับ PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/goodcheck

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5050

# ─── Admin account (auto-created on first run) ──────────────────────────────
GOODCHECK_ADMIN_EMAIL=admin@goodcheck.io
GOODCHECK_ADMIN_USERNAME=admin
GOODCHECK_ADMIN_PASSWORD=Admin123!

# ─── Upload ─────────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=8388608   # bytes (8 MB)
# PRODUCT_UPLOAD_FOLDER=/custom/path/to/uploads
